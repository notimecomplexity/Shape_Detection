<?xml version="1.0"?>
<package format="3">
  <name>pennair_interfaces</name><version>0.1.0</version>
  <description>An Agnostic Algorithm that detects 2D shapes on a background in a video, sketches their outlines, and maps their 3D coordinates.</description>
  <maintainer email="chdyuen@engineering.upenn.edu">Darren</maintainer>
  <license>LicenseRef-Proprietary</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <build_depend>rosidl_default_generators</build_depend>
  <exec_depend>rosidl_default_runtime</exec_depend>
  <depend>std_msgs</depend><depend>geometry_msgs</depend>
  <member_of_group>rosidl_interface_packages</member_of_group>
  <export><build_type>ament_cmake</build_type></export>
</package>
